# Never commit real credentials.

# Phase 1 basic video generation: direct Alibaba Cloud Model Studio / Bailian.
# Wanke is a custom application backend, so this direct provider path must use a
# Pay-As-You-Go Model Studio key. Do NOT put Token Plan / Coding Plan sk-sp-* keys here;
# Alibaba Cloud currently restricts those plans to supported interactive AI tools/agents.
# Singapore API key. When configured, Wanke sends basic video generation directly to
# HappyHorse / Wan and automatically chooses the model for the user.
DASHSCOPE_API_KEY=
# Recommended: Singapore Model Studio workspace ID for the dedicated inference domain.
ALIYUN_MODELSTUDIO_WORKSPACE_ID=
# Optional explicit ORIGINAL API ROOT, e.g. https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com
# Do not use /compatible-mode/v1, /apps/anthropic, token-plan.*, or coding-plan URLs here.
# Leave empty to derive it from ALIYUN_MODELSTUDIO_WORKSPACE_ID, or fall back to dashscope-intl.
ALIYUN_MODELSTUDIO_BASE_URL=

# Existing Yike credentials are optional for remake / avatar / storyboard workflows and
# as a compatibility path for legacy private assets. They are not required for direct
# Model Studio text generation or direct local-image generation.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# Wanke defaults to Singapore. Official Yike SDK region: ap-southeast-1.
ALIYUN_REGION_ID=ap-southeast-1
# Optional. Leave empty to use yike.ap-southeast-1.aliyuncs.com automatically.
# For Shanghai set ALIYUN_REGION_ID=cn-shanghai instead; do not mix regions implicitly.
ALIYUN_YIKE_ENDPOINT=

# Optional SQLite path.
WANKE_DB_PATH=./data/wanke.db
# Local images selected directly in the AI Video page are stored here as retryable inputs.
# They are converted to Base64 only at submit time and are removed when no task references them.
WANKE_INPUT_DIR=./data/inputs
# Optional local archive directory and per-file safety limit.
WANKE_OUTPUT_DIR=./data/outputs
WANKE_MAX_ARCHIVE_MB=2048
WANKE_ARCHIVE_TIMEOUT_MS=1800000

# Final-video assembly requires ffmpeg + ffprobe. The Docker image installs both automatically.
# Bare-metal deployments can normally leave these as the command names below after installing FFmpeg.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WANKE_FFMPEG_TIMEOUT_MS=600000
WANKE_FFPROBE_TIMEOUT_MS=45000
# Optional H.264 assembly tuning. `medium` favors quality; use `fast`/`veryfast` on small CPUs if needed.
WANKE_FFMPEG_PRESET=medium
WANKE_FFMPEG_CRF=20

# ===== SaaS: accounts, plans, admin =====
# Secret used for session hardening and as the salt for one-time account links
# (email verification / password reset). Generate with: openssl rand -hex 32
# Rotating it logs everyone out and invalidates every unused link.
AUTH_SECRET=
# When set, the user registered with this email is promoted to admin (seed admin).
ADMIN_EMAIL=

# ===== Accounts and outbound mail =====
# Every setting below can also be configured in the backoffice (系统设置); the database
# value wins over the environment. Public base URL used inside verification and
# password-reset mails. Required in production: without it the link falls back to the
# request host, which a proxy could spoof.
WANKE_SITE_URL=
# SMTP transport, implemented directly on node:net / node:tls (no extra dependency).
# Port 465 normally uses SSL; port 587 normally leaves it off and upgrades via STARTTLS.
# When mail is disabled or incompletely configured, messages are archived to
# data/mail-outbox/*.eml and reported as NOT delivered - never as sent.
WANKE_EMAIL_HOST=
WANKE_EMAIL_PORT=465
WANKE_EMAIL_SECURE=true
WANKE_EMAIL_FROM=
WANKE_EMAIL_USERNAME=
WANKE_EMAIL_PASSWORD=
# Where unsendable mail is archived (development fallback).
WANKE_MAIL_OUTBOX_DIR=./data/mail-outbox

# ===== Phase 4: server-side creation worker =====
# Creations keep running after the member closes the tab: the Node server starts an
# in-process worker loop on boot (instrumentation.ts). The cadence, timeouts and cost
# protection limits are backoffice settings (系统设置 → 后台任务 / 创作成本保护 / 成本与毛利);
# the database value always wins over the environment.
#
# Set this to run the worker from an external scheduler (cron / systemd timer) instead of
# the in-process loop, then call `node scripts/worker-tick.mjs` on your own cadence. Both
# paths run exactly the same worker code, and a pass is serialized per process.
WANKE_DISABLE_WORKER=
# Bearer token for POST /api/internal/worker, the endpoint an external scheduler calls.
# Leave empty to fail closed: the endpoint answers 404 and only the in-process loop and
# an administrator's manual tick can advance creations. Generate with: openssl rand -hex 24
WANKE_WORKER_TOKEN=
# Base URL and timeout used by scripts/worker-tick.mjs when it calls the endpoint above.
WANKE_BASE_URL=http://127.0.0.1:3000
WANKE_WORKER_TIMEOUT_MS=120000
