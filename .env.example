# Never commit real credentials.

# Phase 1 video generation: direct Alibaba Cloud Model Studio / Bailian.
# Singapore API key. When configured, Wanke sends basic video generation directly to
# HappyHorse 1.1 / Wan 2.7 and automatically chooses the model for the user.
DASHSCOPE_API_KEY=
# Recommended: Singapore Model Studio workspace ID for the dedicated inference domain.
ALIYUN_MODELSTUDIO_WORKSPACE_ID=
# Optional explicit root URL, e.g. https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com
# Leave empty to derive it from ALIYUN_MODELSTUDIO_WORKSPACE_ID, or fall back to dashscope-intl.
ALIYUN_MODELSTUDIO_BASE_URL=

# Existing Yike credentials remain optional for remake / avatar / storyboard workflows
# and as a compatibility fallback for legacy video assets.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# Wanke defaults to Singapore. Official Yike SDK region: ap-southeast-1.
ALIYUN_REGION_ID=ap-southeast-1
# Optional. Leave empty to use yike.ap-southeast-1.aliyuncs.com automatically.
# For Shanghai set ALIYUN_REGION_ID=cn-shanghai instead; do not mix regions implicitly.
ALIYUN_YIKE_ENDPOINT=

# Optional SQLite path.
WANKE_DB_PATH=./data/wanke.db
# Local images selected directly in the AI Video page are stored here as retryable inputs.
# They are converted to Base64 only at submit time and are removed when no task references them.
WANKE_INPUT_DIR=./data/inputs
# Optional local archive directory and per-file safety limit.
WANKE_OUTPUT_DIR=./data/outputs
WANKE_MAX_ARCHIVE_MB=2048
WANKE_ARCHIVE_TIMEOUT_MS=1800000
