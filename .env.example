# Never commit real credentials.

# Phase 1 basic video generation: direct Alibaba Cloud Model Studio / Bailian.
# Wanke is a custom application backend, so this direct provider path must use a
# Pay-As-You-Go Model Studio key. Do NOT put Token Plan / Coding Plan sk-sp-* keys here;
# Alibaba Cloud currently restricts those plans to supported interactive AI tools/agents.
# Singapore API key. When configured, Wanke sends basic video generation directly to
# HappyHorse / Wan and automatically chooses the model for the user.
DASHSCOPE_API_KEY=
# Recommended: Singapore Model Studio workspace ID for the dedicated inference domain.
ALIYUN_MODELSTUDIO_WORKSPACE_ID=
# Optional explicit ORIGINAL API ROOT, e.g. https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com
# Do not use /compatible-mode/v1, /apps/anthropic, token-plan.*, or coding-plan URLs here.
# Leave empty to derive it from ALIYUN_MODELSTUDIO_WORKSPACE_ID, or fall back to dashscope-intl.
ALIYUN_MODELSTUDIO_BASE_URL=

# Existing Yike credentials are optional for remake / avatar / storyboard workflows and
# as a compatibility path for legacy private assets. They are not required for direct
# Model Studio text generation or direct local-image generation.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# Wanke defaults to Singapore. Official Yike SDK region: ap-southeast-1.
ALIYUN_REGION_ID=ap-southeast-1
# Optional. Leave empty to use yike.ap-southeast-1.aliyuncs.com automatically.
# For Shanghai set ALIYUN_REGION_ID=cn-shanghai instead; do not mix regions implicitly.
ALIYUN_YIKE_ENDPOINT=

# Optional SQLite path.
WANKE_DB_PATH=./data/wanke.db
# Local images selected directly in the AI Video page are stored here as retryable inputs.
# They are converted to Base64 only at submit time and are removed when no task references them.
WANKE_INPUT_DIR=./data/inputs
# Optional local archive directory and per-file safety limit.
WANKE_OUTPUT_DIR=./data/outputs
WANKE_MAX_ARCHIVE_MB=2048
WANKE_ARCHIVE_TIMEOUT_MS=1800000

# Final-video assembly requires ffmpeg + ffprobe. The Docker image installs both automatically.
# Bare-metal deployments can normally leave these as the command names below after installing FFmpeg.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WANKE_FFMPEG_TIMEOUT_MS=600000
WANKE_FFPROBE_TIMEOUT_MS=45000
# Optional H.264 assembly tuning. `medium` favors quality; use `fast`/`veryfast` on small CPUs if needed.
WANKE_FFMPEG_PRESET=medium
WANKE_FFMPEG_CRF=20
